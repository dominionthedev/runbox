# vim:ft=toml
# Runbox's own config — copy to ~/.config/runbox/config.toml.
# Distinct from box.toml, which is a per-project box spec, not tool config.

schema_version = 1

[defaults.setup]
# Applied to every box at provisioning, before the project's own [setup].
# NOT part of box.lock/reproduction — personal preference, not a project
# requirement.
provision = [
  # { src = "zshrc.template", dest = ".zshrc" },
]
commands = [
  # "git config --global user.name 'DominionDev'",
]

[doctor]
after_destroy = true # cheap orphan check after every `runbox destroy`
scheduled = false    # opt-in periodic sweep via launchd, not a daemon
interval = "24h"

# Applied to every box by default, wrapping (not replacing) the box's own
# [hooks]: on_enter runs global-then-box, on_exit runs box-then-global —
# same as any setup/teardown ordering. Always shell-form.
[hooks]
# on_enter = "echo entering a runbox"
# on_exit = "echo leaving a runbox"
