# vim:ft=toml
# Example box.toml — copy to your project root as `box.toml`.

[box]
name = "myproject"
lifecycle = "persistent" # persistent | stateless | ephemeral
interactive = true       # false = headless, runs under launchd
shell = "/bin/zsh"       # what `runbox shell` execs — the account's own
# UserShell is deliberately /usr/bin/false

[network]
mode = "deny"
allowlist = ["registry.npmjs.org:443", "github.com:443"]
dns = "localhost-only"
timeout = "30s"

[env]
set = { NODE_ENV = "development" }
pass_through = [
] # host env vars to carry into the box, by name — empty by default
# path_extra bridges to a HOST-installed toolchain (rustup, nvm) — pair
# with a matching [permissions].read grant on the same directory, or the
# binary is on PATH but still unreadable. Appends to the baseline PATH,
# never replaces it — [env].set rejects PATH outright.
# path_extra = ["/Users/dominion/.cargo/bin"]

[permissions]
read = []  # extra host paths, absolute, beyond the project directory
# read = ["/Users/dominion/.cargo", "/Users/dominion/.rustup"]
write = []

# [run] is optional for interactive boxes (falls back to `runbox exec
# <args>` / `runbox shell`), but REQUIRED for headless boxes — otherwise
# `runbox start` has nothing to run and there's no way to reach the box
# afterward. `cmd` follows the same shell-form/exec-form convention as
# `runbox exec`'s own arguments:
#   cmd = "node server.js"          # shell-form — one string, via $SHELL -c
#   cmd = ["node", "server.js"]     # exec-form — array, no shell
[run]
cmd = "npm run dev"
dir = "src"   # optional — cwd for `runbox exec`/`shell`, relative to project root

# Runs as separate runbox-helper invocations before/after the main
# command — NOT sourced into the same shell session, so a `cd` or export
# here does not carry over. Always shell-form (single string).
[hooks]
on_enter = "echo entering box"
on_exit = "echo leaving box"

[setup]
provision = [
  # { src = "npmrc.template", dest = ".npmrc" },
]
commands = ["npm ci"]
# script = "setup.sh"   # mutually exclusive with `commands` — pick one

[audit]
record = true
retention = "30d"
